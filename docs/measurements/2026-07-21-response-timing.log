## Phase 3 — 모드 장르 소프트 필터 (별칭 사전: 영어 전용 → 영/한 병기)
# 별칭 수정 전
[genre-match] matched=10/20 genres=indie pop,acoustic
[genre-match] matched=0/20 genres=folk,blues
[genre-match] matched=14/20 genres=pop,r&b
[genre-match] matched=0/20 genres=dance,edm
[genre-match] matched=0/20 genres=jazz,lo-fi
[genre-match] matched=0/20 genres=folk,acoustic
# 별칭 수정 후 (한국어 라벨 반영, 동일 텍스트 3종)
[genre-match] matched=5/20 genres=folk,blues labels=싱어송라이터:4,OST:4,얼터너티브:3,K-Pop:3
[genre-match] matched=18/20 genres=indie pop,acoustic labels=J-Pop:5,K-Pop:4,얼터너티브:4,싱어송라이터:4
[genre-match] matched=20/20 genres=dance,edm labels=K-Pop:14,댄스:6
[genre-match] matched=20/20 genres=pop,r&b labels=팝:8,R&B/소울:6,K-Pop:4,J-Pop:2
[genre-match] matched=8/20 genres=folk,acoustic labels=싱어송라이터:5,얼터너티브 포크:2,팝:2,J-Pop:2
[genre-match] matched=8/20 genres=jazz,lo-fi labels=R&B/소울:5,재즈:4,힙합/랩:3,얼터너티브:2
# 평균 매칭률 20% → 66%, 수율 20/20 유지, 타이밍 영향 없음

## Phase 4 — 모드 분리도(mode-separation) 지표 및 soothe 장르 재설계
# baseline (수정 전)
[mode-separation] emotion=anger overlap=0%
[mode-separation] emotion=joy overlap=30%
[mode-separation] emotion=sadness overlap=70%
# 1차 수정 (모호 감정 soothe 재배치): sadness 개선, joy는 city pop 라벨 충돌로 악화
[mode-separation] emotion=anger overlap=5%
[mode-separation] emotion=joy overlap=55%
[mode-separation] emotion=sadness overlap=35%
# 2차 수정 (city pop → jazz/soul)
[mode-separation] emotion=joy overlap=20%
[mode-separation] emotion=excited overlap=10%
# 최종: anger 0~5% / joy 20% / excited 10% / sadness 35% (baseline: joy 30%, sadness 70%)
